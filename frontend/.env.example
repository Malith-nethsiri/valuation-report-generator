# =============================================================================
# Frontend Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# Backend API URL (REQUIRED)
# -----------------------------------------------------------------------------
# Development:
VITE_API_URL=http://localhost:8000
# Production (replace with your actual API domain):
# VITE_API_URL=https://api.your-domain.com

# -----------------------------------------------------------------------------
# Google Maps API Key
# Note: This key is exposed in the browser. Ensure it's restricted by:
# 1. HTTP referrer restrictions
# 2. API restrictions (only Maps JavaScript API, Places API)
# -----------------------------------------------------------------------------
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# -----------------------------------------------------------------------------
# Sentry Error Tracking (Production)
# -----------------------------------------------------------------------------
# Get DSN from: https://sentry.io/settings/projects/{project}/keys/
VITE_SENTRY_DSN=
