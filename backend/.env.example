# ============================================================
# VALUATION REPORT GENERATOR — Environment Variables Template
# ============================================================
# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local or .env to version control.
# ALL values here are placeholders — do not use them as-is.
# ============================================================

# --- Server ---
ENV=development
PORT=8000

# --- CORS ---
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend URL (used for password reset links in emails) ---
FRONTEND_URL=http://localhost:5173

# --- Database ---
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# --- JWT Secrets (generate with: openssl rand -base64 64) ---
SECRET_KEY=replace-with-a-long-random-secret-key
REFRESH_TOKEN_SECRET_KEY=replace-with-a-different-long-random-secret-key

# --- Google APIs ---
GOOGLE_MAPS_API_KEY=your-google-maps-api-key
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key

# --- Google OAuth ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- Anthropic (Claude AI) ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# --- AI Model Configuration ---
# Default model for OCR parsing, narratives, property extraction
AI_DEFAULT_MODEL=claude-3-5-haiku-20241022
# Model for vehicle valuation (can differ from default)
AI_VEHICLE_MODEL=claude-3-5-haiku-20241022

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Email (SendGrid) ---
SENDGRID_API_KEY=SG.your-sendgrid-api-key
EMAIL_FROM=noreply@yourdomain.com

# --- File Storage ---
FILE_STORAGE_DIR=./uploads
FILE_TTL_SECONDS=3600

# --- Error Tracking (Sentry) ---
SENTRY_DSN=https://your-key@sentry.io/your-project-id

# --- Auto Migrations (Alembic) ---
# Set to true to run alembic upgrade head on startup
AUTO_MIGRATE=false
